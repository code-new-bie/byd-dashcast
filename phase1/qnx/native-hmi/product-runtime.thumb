// Exact original Node2D / RenderPass entry ABI. Projection-only, no data edits.
// Node name at +0xb4 and parent at +0x2c are hash-checked native method semantics.
// 16/17 are live draw progress; 27/28 count scoped 2D/3D suppression.
runtime_2d:
push.w {r0, r1, r2, r3, r4, r5, r6, r7, r8, lr}
ldr r4, runtime_state
ldr r5, [r4, #36]
cmp r5, #0
beq runtime_2d_original
ldr r5, [r4]
cmp r5, #0
beq runtime_2d_original
ldr r6, [r5, #64]
adds r6, #1
str r6, [r5, #64]
bl runtime_hide_2d
cmp r0, #0
beq runtime_2d_original
ldr r6, [r5, #108]
adds r6, #1
str r6, [r5, #108]
pop.w {r0, r1, r2, r3, r4, r5, r6, r7, r8, lr}
bx lr
runtime_2d_original:
pop.w {r0, r1, r2, r3, r4, r5, r6, r7, r8, lr}
push.w {r4, r5, r6, r7, r8, r9, r10, r11, lr}
b.w #0x081d1600

runtime_mesh:
