adds r6, #1
str r6, [r5, #112]
pop.w {r0, r1, r2, r3, r4, r5, r6, r7, r8, lr}
bx lr
runtime_mesh_original:
pop.w {r0, r1, r2, r3, r4, r5, r6, r7, r8, lr}
push {r4, r5, lr}
sub sp, #12
b.w #0x08216188

runtime_brush:
push {r0, r1, r2, r3, r4, lr}
ldr r4, runtime_state
ldr r1, [r4, #36]
cmp r1, #0
beq runtime_brush_original
