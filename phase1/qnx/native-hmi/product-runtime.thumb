runtime_brush_original:
pop {r0, r1, r2, r3, r4, lr}
ldr r2, runtime_literal
push {r4, r5, r6, lr}
b.w #0x081d09fc

// r0 Node, r1 ASCII literal, r2 exact length. No allocations or foreign calls.
runtime_name:
cmp r0, #0
beq runtime_no_name
ldr.w r3, [r0, #180]
cmp r3, #0
beq runtime_no_name
ldr r12, [r3, #-12]
cmp r12, r2
bne runtime_no_name
runtime_name_loop:
ldrb r0, [r3], #1
ldrb r12, [r1], #1
cmp r0, r12
bne runtime_no_name
subs r2, #1
bne runtime_name_loop
movs r0, #1
bx lr
runtime_no_name:
movs r0, #0
bx lr

runtime_hide_2d:
push {r4, r5, r6, r7, r8, lr}
mov r4, r0
adr r1, runtime_car
movs r2, #3
bl runtime_name
cmp r0, #0
bne runtime_car_parent
mov r0, r4
