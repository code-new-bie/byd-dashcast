runtime_2d_registry:
mov r0, r5
bl runtime_registered
cmp r0, #0
bne runtime_2d_yes
b runtime_2d_next

// The OEM loader instantiates roots as NN%u, not the resource's prefab name.
// Match the CURRENT shared_ptr registry slot, so reused names cannot hide other scenes.
// RcKanziGetApplication is the hash-checked, allocation-free original pointer getter.
runtime_registered:
push {r4, r5, r6, lr}
mov r4, r0
mov r5, r1
bl #0x08104800
cmp r0, #0
beq runtime_registered_no
ldr r0, [r0, r5]
cmp r0, r4
ite eq
moveq r0, #1
movne r0, #0
pop {r4, r5, r6, pc}
runtime_registered_no:
movs r0, #0
pop {r4, r5, r6, pc}

